{
  "name": "beidou-work",
  "version": "0.7.0",
  "private": true,
  "description": "北斗work monorepo:apps/desktop(Electron 壳)+ packages(beidou-core/domain-contracts/ontology-schema/dsh-plugin-beidou)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "desktop:dev": "npm run dev --workspace @beidou/desktop",
    "desktop:dist": "npm run dist --workspace @beidou/desktop",
    "dsh:poc": "node scripts/build-plugin.mjs && node scripts/generate-cordis-config.mjs && dsh web --patch .tmp/cordis.local.yml",
    "dsh:probe": "npm run plugin:build && node scripts/generate-cordis-config.mjs && node scripts/dsh-poc-probe.mjs",
    "test:coverage": "npm run test:coverage --workspace @beidou/core --if-present",
    "plugin:build": "node scripts/build-plugin.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "esbuild": "^0.28.2"
  }
}