{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@beidou-core/*": [
        "../beidou-core/src/*"
      ],
      "@beidou-ontology": [
        "../ontology-schema/src/index.ts"
      ]
    },
    "moduleDetection": "force",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "../beidou-core/src",
    "../domain-contracts/src",
    "../ontology-schema/src"
  ],
  "exclude": [
    "../**/*.test.ts",
    "../**/*.test.tsx"
  ]
}