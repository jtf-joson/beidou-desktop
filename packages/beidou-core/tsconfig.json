{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@beidou/ontology-schema/src/*": [
        "../ontology-schema/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}