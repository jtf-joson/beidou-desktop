{
  "name": "@beidou/desktop",
  "productName": "北斗work",
  "version": "0.16.0",
  "description": "北斗work —— 数据智能体工作台(仿 DataBuddy:语义配置 + 技能插件 + 智能问数/下钻/明细分析)",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && rm -rf out/resources && cp -R resources out/resources",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.274",
    "@anthropic-ai/sdk": ">=0.93.0",
    "@beidou/core": "file:../../packages/beidou-core",
    "@beidou/ontology-schema": "file:../../packages/ontology-schema",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "mysql2": "^3.11.0",
    "yaml": "2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mysql": "^2.15.26",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "antd": "^5.21.0",
    "electron": "33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.lixiang.beidouwork",
    "productName": "北斗work",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "node_modules/**",
      "!node_modules/.cache/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "北斗work 安装",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asarUnpack": [
      "resources/**"
    ]
  }
}
